    {
      "name": "sapin/vente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const bon = pm.response.json();",
              "pm.test('totals, address and sold flag', () => {",
              "  pm.expect(bon.coutTotal).to.eql(35);",
              "  pm.expect(bon.poidsTotal).to.eql(4);",
              "  pm.expect(bon.adresse).to.eql('Maxime rue du bonjour');",
              "  pm.expect(bon.sapin.vendu).to.eql(true);",
              "  pm.expect(bon.client.pointsFidelite).to.be.at.least(3);",
              "});",
              "pm.collectionVariables.set('commandeId', bon.id);"
            ]
          }
        }
      ],
