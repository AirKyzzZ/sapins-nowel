  "item": [
    {
      "name": "sapin/create",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const count = pm.response.json();",
              "pm.test('returns a positive count', () => pm.expect(count).to.be.above(0));",
              "pm.collectionVariables.set('sapinId', count);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sapin/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sapin",
            "create"
          ]
        }
      }
    },
    {
      "name": "sapin/get",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const sapin = pm.response.json();",
              "pm.test('new sapin is unsold and empty', () => {",
              "  pm.expect(sapin.vendu).to.eql(false);",
              "  pm.expect(sapin.decorations).to.eql([]);",
              "});"
            ]
          }
        }
      ],
